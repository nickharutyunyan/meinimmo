{
  "name": "review-a-house",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "helper:package": "node scripts/package-helper.mjs",
    "test": "node --no-warnings --expose-gc --experimental-strip-types --test tests/*.test.mjs",
    "dev": "next dev --turbopack",
    "build": "npm run helper:package && next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build && node --experimental-strip-types scripts/publish-static-pages.mjs",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "upload": "npm run build:worker && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "auth-db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "auth-db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "leaflet": "^1.9.4",
    "next": "16.3.2",
    "parse5": "^7.3.0",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "22.10.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.9.3",
    "wrangler": "^4.125.0"
  }
}
