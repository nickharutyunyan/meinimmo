{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodhomes",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "reviewahouse.com",
      "custom_domain": true
    },
    {
      "pattern": "www.reviewahouse.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "goodhomes"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "habitat",
      "database_id": "17b0a2e1-41f5-402e-ba7a-5226265d811b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "AUTH_DB",
      "database_name": "reviewahouse-auth",
      "database_id": "2520cbde-a059-4cba-82de-ca1b3eec2598",
      "migrations_dir": "auth-migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PAYMENTS_ENABLED": "true",
    "REPORT_LIMITS_ENABLED": "false",
    "OPENROUTER_MODEL": "google/gemma-4-26b-a4b-it:free",
    "STRIPE_PRICE_DAY_PASS": "price_1U8ii4RQaSxEwZxWRf4Aczff",
    "STRIPE_PRICE_PRO": "price_1U8iiHRQaSxEwZxWKW86QZfe",
    "STRIPE_PRICE_ULTRA": "price_1U8iiLRQaSxEwZxWGtZM8zax",
    "PASSWORD_RESET_FROM": "ReviewAHouse <account@updates.reviewahouse.com>"
  }
}
