# Never commit your real keys. Copy this file to .env locally or configure these values in your hosting provider.
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
TYPESAFE_API_KEY=replace_with_your_typesafe_key
JEV_MODEL=jev-latest
APP_URL=http://localhost:3000
PORT=3000
# Fact checking: openrouter (default) or jev (experimental, with fallback).
FACT_CHECK_PROVIDER=openrouter
